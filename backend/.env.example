# Copy to .env and fill in. Never commit real values.

# --- Database ---------------------------------------------------------------
# Overridden by docker-compose.yml in local dev (points to the `db` service).
DATABASE_URL=postgresql://anibet:anibet_dev_only@localhost:5432/anibet

# --- Secrets (long random strings: `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
SECRET_KEY=
SESSION_SECRET_KEY=

# --- Frontend origin (CORS + OAuth redirects) --------------------------------
FRONTEND_URL=http://localhost:3000
# Optional, comma-separated extra CORS origins
EXTRA_CORS_ORIGINS=

# --- OAuth (required at startup) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/callback/google

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:5000/auth/callback/discord

# --- Image uploads (Cloudflare R2, S3-compatible) -----------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=
CLOUDFLARE_PUBLIC_URI=

# --- Team email alerts (optional: without a key, no email is sent) -----------
RESEND_API_KEY=
NOTIFY_EMAIL=
EMAIL_FROM=aniBet <notifications@example.com>

# --- Runtime ------------------------------------------------------------------
# "production" hides /docs, /redoc and /openapi.json
ENV=development
